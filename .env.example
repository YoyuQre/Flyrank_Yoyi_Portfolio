# ------------------------------------------------------------------
# Microsoft Clarity — visitor tracking, session recordings & heatmaps
# ------------------------------------------------------------------
# 1. Create a free project at https://clarity.microsoft.com
# 2. Copy your Project ID (e.g. "abc123xyz") and paste it below
# 3. Save this as `.env.local` (already gitignored), or set it as an
#    environment variable on your host platform (Vercel/Netlify/etc.)
#
# When unset, the component falls back to a compiled-in project id so
# analytics keeps working on the host platform. Tracking is also skipped
# on localhost / 127.0.0.1. See src/lib/tracking.ts.
NEXT_PUBLIC_CLARITY_ID=

# ------------------------------------------------------------------
# Supabase — contact form storage
# ------------------------------------------------------------------
# 1. Create a project at https://supabase.com
# 2. Run this SQL in the SQL editor to create the table:
#
#    create table public.contact_submissions (
#      id bigint generated always as identity primary key,
#      name text not null,
#      email text not null,
#      message text not null,
#      created_at timestamptz not null default now()
#    );
#
# 3. Copy Project URL and service_role key from
#    Project Settings → API, and paste below.
#
# The service_role key bypasses RLS and must only ever be set server-side
# (never as a NEXT_PUBLIC_* variable). The form still works without these —
# it just won't persist anywhere.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# Resend — contact form email delivery
# ------------------------------------------------------------------
# The contact form sends every submission to your inbox through Resend
# (https://resend.com). Free tier: 3,000 emails / month.
#
# 1. Create a free account at https://resend.com
# 2. Create an API key at https://resend.com/api-keys and paste it below
# 3. Choose a sender address:
#    - Default: "onboarding@resend.dev" — no setup, but it can only send to
#      the email address you signed up with.
#    - Better: verify a domain you own under Domains, then set
#      RESEND_FROM_EMAIL to something like "hello@yourdomain.com".
#
# RESEND_API_KEY    required — server-only secret, never expose it
# RESEND_FROM_EMAIL optional — verified sender; defaults to onboarding@resend.dev
# CONTACT_EMAIL     optional — where messages are delivered; defaults to the
#                   address in src/lib/site.ts
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_EMAIL=
